// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger

[
  {
    "label": "Debug main package",
    "adapter": "Delve",
    "program": "${ZED_WORKTREE_ROOT}/.examples/",
    "request": "launch",
    "mode": "debug"
  },
  {
    "label": "Debug current file",
    "adapter": "Delve",
    "program": "$ZED_FILE",
    "request": "launch",
    "mode": "debug"
  },
  {
    "label": "Run tests in current package",
    "adapter": "Delve",
    "program": "$ZED_DIRNAME",
    "request": "launch",
    "mode": "test"
  }
]
